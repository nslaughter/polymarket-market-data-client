# Raw captures from the source-behavior spike, and the excerpts cut from them.
# Both are Polymarket's data, which its Terms of Use give no right to
# redistribute; they stay on the machine that made them.
spikes/captures/
spikes/evidence/*.jsonl
spikes/evidence/*.jsonl.gz
__pycache__/

# The research example's timelines, as the README's command writes them at
# the checkout's root: from the live service, they are Polymarket's data too.
/*.jsonl

# The development environment, build outputs, and tool caches.
.venv/
dist/
.mypy_cache/
.pytest_cache/
.ruff_cache/
